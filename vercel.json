{
  "version": 2,
  "framework": null,
  "buildCommand": "npm install",
  "outputDirectory": ".",
  "crons": [
    {
      "path": "/api/send-notifications",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/send-notifications",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/send-notifications",
      "schedule": "0 1 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
